# Papermerge DMS — reference dev environment.
#
# Usage:
#   1) cp .env.dev .env
#   2) edit SECRET_KEY / ADMIN_PASSWORD / POSTGRES_PASSWORD for your setup
#   3) docker compose up -d --build
#
# .env is in .gitignore — never commit it. This file (.env.dev) is the
# committed reference; docker compose reads ONLY .env at runtime.

# --- Security ---------------------------------------------------------------
# Shared secret used by the auth server and the core API. Must be the same
# value for both (they live inside the same container in monolithic mode).
# Regenerate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# --- Public HTTP port -------------------------------------------------------
# Host port mapped to nginx:80 inside the app container.
APP_PORT=12000

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=papermerge
POSTGRES_PASSWORD=papermerge
POSTGRES_DB=papermerge

# --- First-boot superuser ---------------------------------------------------
# Created automatically on the first `docker compose up`. Also receives the
# "admin" role (full permissions) so the UI is ready to use immediately.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@example.com

# --- Full-text search (Solr via salinic) -------------------------------------
# Docker Compose sets PAPERMERGE__SEARCH__URL=solr://solr:8983/papermerge
# inside app/index_worker (see docker-compose.yml). Do not put 127.0.0.1 here
# unless you only run native backend (run-dev-native.bat sets it in the shell).

# --- Public library catalog (optional) ---------------------------------------
# UUID of the folder used as the guest browse root. When unset, bootstrap uses
# the admin user's home folder (see `paper-cli library init-catalog`).
# PAPERMERGE__LIBRARY__CATALOG_ROOT_NODE_ID=

# --- Native backend + frontend (`run-dev-native.bat`) ------------------------
# Docker Postgres is published on localhost:5432. The core API reads this via
# `.env` (pydantic-settings) so `fastapi dev` reload children still connect
# correctly on Windows.
PAPERMERGE__DATABASE__URL=postgresql://papermerge:papermerge@127.0.0.1:5432/papermerge
PAPERMERGE__REDIS__URL=redis://127.0.0.1:6379/0
PAPERMERGE__MAIN__API_PREFIX=/api
PAPERMERGE__MAIN__MEDIA_ROOT=media
PAPERMERGE__SEARCH__URL=solr://127.0.0.1:8983/papermerge
PAPERMERGE__DEV__AUTH_BYPASS_ENABLED=true
PAPERMERGE__DEV__AUTH_BYPASS_USERNAME=admin
