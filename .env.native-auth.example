# Copy this file to .env.native-auth and use it with:
# docker compose --env-file .env.native-auth up -d --build

# Shared secret for auth-server and papermerge.
SECRET_KEY=change-me-to-a-random-secret

# PostgreSQL connection details used by db/auth-server/papermerge/worker.
DB_USER=pmg
DB_PASSWORD=change-me
DB_NAME=pmgdb

# Public host port for the nginx gateway.
GATEWAY_PORT=18000

# Optional worker tuning.
OCR_WORKER_ARGS=-Q ocr -c 2

# First auth admin account to create with auth-cli.
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=change-me
AUTH_ADMIN_EMAIL=admin@example.com
