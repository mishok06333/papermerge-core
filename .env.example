# Copy this file to .env and fill in real values before running docker compose.
# Never commit .env to version control.

# --- Security ---
# Must be a long, random string. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# --- PostgreSQL ---
DB_USER=pmg
DB_PASSWORD=change-me
DB_NAME=pmgdb

# --- Public port for auth gateway (host port mapped to container port 80) ---
GATEWAY_PORT=18000

# --- Optional OCR worker tuning ---
OCR_WORKER_ARGS=-Q ocr -c 2

# --- First auth admin account (used by auth-cli command) ---
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=change-me
AUTH_ADMIN_EMAIL=admin@example.com
