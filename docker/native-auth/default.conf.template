server {
    listen 80;
    server_name _;

    sendfile off;
    client_max_body_size 100M;
    proxy_buffers 16 16k;
    proxy_buffer_size 16k;

    error_page 401 = @authserver;

    location = /verify {
        internal;
        proxy_pass http://${PAPERMERGE_AUTH_API_UPSTREAM}/verify;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Original-Remote-Addr $remote_addr;
        proxy_set_header X-Original-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location ~ ^/api(/?)(.*) {
        auth_request /verify;
        auth_request_set $auth_cookie $upstream_http_set_cookie;
        add_header Set-Cookie $auth_cookie always;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Remote-User "";
        proxy_set_header Remote-Groups "";
        proxy_set_header Remote-Roles "";
        proxy_set_header Remote-Email "";
        proxy_set_header Remote-Name "";
        proxy_pass http://${PAPERMERGE_NATIVE_CORE_HOST}:${PAPERMERGE_NATIVE_CORE_PORT}$request_uri;
    }

    location /docs {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_pass http://${PAPERMERGE_NATIVE_CORE_HOST}:${PAPERMERGE_NATIVE_CORE_PORT}/docs;
    }

    location /openapi.json {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_pass http://${PAPERMERGE_NATIVE_CORE_HOST}:${PAPERMERGE_NATIVE_CORE_PORT}/openapi.json;
    }

    # Always route login URLs to the auth UI, even if a stale session still passes auth_request.
    location ~ ^/login/?$ {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_pass http://${PAPERMERGE_AUTH_UI_UPSTREAM}$request_uri;
    }

    location /ws {
        auth_request /verify;
        auth_request_set $auth_cookie $upstream_http_set_cookie;
        add_header Set-Cookie $auth_cookie always;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Remote-User "";
        proxy_set_header Remote-Groups "";
        proxy_set_header Remote-Roles "";
        proxy_set_header Remote-Email "";
        proxy_set_header Remote-Name "";
        proxy_pass http://${PAPERMERGE_NATIVE_CORE_HOST}:${PAPERMERGE_NATIVE_CORE_PORT}$request_uri;
    }

    # Explicit MIME for ES module worker files (pdf.js) behind auth gateway.
    location ~* \.mjs$ {
        root /usr/share/nginx/html/ui;
        default_type application/javascript;
        try_files $uri =404;
    }

    # Stable worker path used by pdf.js in production builds.
    location = /pdf.worker.min.js {
        root /usr/share/nginx/html/ui;
        default_type application/javascript;
        try_files $uri =404;
    }

    location / {
        auth_request /verify;
        auth_request_set $auth_cookie $upstream_http_set_cookie;
        add_header Set-Cookie $auth_cookie always;

        root /usr/share/nginx/html/ui;
        index index.html;
        try_files $uri /index.html =404;
    }

    location @authserver {
        if ($request_uri ~ ^/api/(token|auth)) {
            rewrite ^/api/(.*) /$1 break;
            proxy_pass http://${PAPERMERGE_AUTH_API_UPSTREAM};
        }

        if ($request_uri ~ ^/api) {
            return 401 "Unauthorized";
        }

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_pass http://${PAPERMERGE_AUTH_UI_UPSTREAM};
    }
}
